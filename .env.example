# HoopAI API configuration. Copy to .env and fill in.
#
# Only HOOPAI_SECRET_KEY is required — everything else has a working default
# for local development. The process refuses to start without it, on purpose:
# this repository is public, so a key with a default value in the source is a
# key the whole internet has, and anyone holding it can mint a session token
# for any account.

# Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Minimum 32 characters. Never commit the real value.
HOOPAI_SECRET_KEY=

# How long a login lasts. Short, because these tokens live on student laptops.
HOOPAI_TOKEN_TTL_HOURS=12

# Comma-separated browser origins allowed to call the API. There is no
# wildcard: add the front-end's real origin when there is one.
HOOPAI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -- Storage (set by the container; leave blank locally) ----------------------
# HOOPAI_DB_PATH=/data/db/hoopai.db
# HOOPAI_UPLOAD_DIR=/data/uploads
# HOOPAI_HIGHLIGHTS_DIR=/data/highlights
# HOOPAI_MODEL_PATH=/models/basketball.pt

# -- Limits -------------------------------------------------------------------
# Largest accepted upload.
HOOPAI_MAX_UPLOAD_MB=512

# Smallest accepted upload, in bytes. Without a floor a 0-byte .mp4 is a free
# jobs row and a free directory for anyone with an account — and signup is
# open. A loop of those exhausts inodes rather than disk.
HOOPAI_MIN_UPLOAD_BYTES=1024

# Stored jobs per account. Finite is the point; 50 is a term of coursework.
HOOPAI_MAX_JOBS_PER_USER=50

# Concurrent pipeline runs, and how many may wait. Raising JOB_WORKERS raises
# the CPU this app can take from everything else on the host — the pipeline is
# per-frame YOLO inference and one run saturates a core. On the shared VPS,
# leave it at 1.
HOOPAI_JOB_WORKERS=1
HOOPAI_JOB_QUEUE_SIZE=8
HOOPAI_JOB_TIMEOUT_SECONDS=1800

# -- Account protection -------------------------------------------------------
HOOPAI_MIN_PASSWORD_LENGTH=10
HOOPAI_LOGIN_MAX_FAILURES=10
HOOPAI_LOGIN_LOCKOUT_SECONDS=900
