# HoopAI API configuration. Copy to .env and fill in.
#
# Only HOOPAI_SECRET_KEY is required — everything else has a working default
# for local development. The process refuses to start without it, on purpose:
# this repository is public, so a key with a default value in the source is a
# key the whole internet has, and anyone holding it can mint a session token
# for any account.

# Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Minimum 32 characters. Never commit the real value.
HOOPAI_SECRET_KEY=

# How long a login lasts. Short, because these tokens live on student laptops.
HOOPAI_TOKEN_TTL_HOURS=12

# Comma-separated browser origins allowed to call the API. There is no
# wildcard: add the front-end's real origin when there is one.
#
# An origin is scheme + host + optional port and NEVER a path, so write
# `https://example.com`, not `https://example.com/`. An entry with a trailing
# slash matches nothing, and the symptom is identical to not having edited this
# file at all: the preflight comes back 400 "Disallowed CORS origin" with no
# Access-Control-Allow-Origin header, and the browser reports it to the
# front-end as an unreachable server.
HOOPAI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional. One regex for origins that cannot be listed ahead of time. Unset by
# default; nothing is admitted by pattern unless you ask for it.
#
# The case it exists for: each front-end published on Figma's hosting gets its
# own randomly generated subdomain, and whoever owns the site can change it
# from that file's Settings at any time — the old address stops working
# immediately, and nothing on this side is told. An exact list therefore needs
# one entry per site and goes stale without warning.
#
# It does not need its own ^ and $ — the value is wrapped so that it can only
# match a whole origin, which is what stops a pattern for `*.figma.site` from
# also admitting `https://x.figma.site.attacker.example`. Do prefer a specific
# character class over `.*`/`.+`, which match `/`, `@`, `#` and `?` as well.
#
# Know what the example grants: `figma.site` is shared hosting anyone can
# publish to, so this admits a stranger's page as readily as a student's — the
# same class of decision as allow-listing `*.github.io`. It stays a small grant
# only because credentials are off and auth is a Bearer header, so an admitted
# origin gets calls any machine could already make and not the ability to act
# as a logged-in student. Revisit this setting first if auth ever moves to a
# cookie.
# HOOPAI_CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.figma\.site$

# -- Storage (set by the container; leave blank locally) ----------------------
# HOOPAI_DB_PATH=/data/db/hoopai.db
# HOOPAI_UPLOAD_DIR=/data/uploads
# HOOPAI_HIGHLIGHTS_DIR=/data/highlights
# HOOPAI_MODEL_PATH=/models/basketball.pt

# -- Limits -------------------------------------------------------------------
# Largest accepted upload.
HOOPAI_MAX_UPLOAD_MB=512

# Smallest accepted upload, in bytes. Without a floor a 0-byte .mp4 is a free
# jobs row and a free directory for anyone with an account — and signup is
# open. A loop of those exhausts inodes rather than disk.
HOOPAI_MIN_UPLOAD_BYTES=1024

# Stored jobs per account. Finite is the point; 50 is a term of coursework.
HOOPAI_MAX_JOBS_PER_USER=50

# Concurrent pipeline runs, and how many may wait. Raising JOB_WORKERS raises
# the CPU this app can take from everything else on the host — the pipeline is
# per-frame YOLO inference and one run saturates a core. On the shared VPS,
# leave it at 1.
HOOPAI_JOB_WORKERS=1
HOOPAI_JOB_QUEUE_SIZE=8
HOOPAI_JOB_TIMEOUT_SECONDS=1800

# -- Account protection -------------------------------------------------------
HOOPAI_MIN_PASSWORD_LENGTH=10
HOOPAI_LOGIN_MAX_FAILURES=10
HOOPAI_LOGIN_LOCKOUT_SECONDS=900
