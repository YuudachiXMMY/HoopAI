# ---- Datasets ----
# Ignore dataset payloads (images, labels, caches) but keep the YAML
# configs and Roboflow metadata needed to reproduce a training run.
data/**
!data/**/
!data/**/*.yaml
!data/**/*.yml
!data/**/*.json
!data/**/README*.txt
!data/.gitkeep
